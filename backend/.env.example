# 실제 AI 사용: openai / 화면 및 흐름 점검: demo
APP_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# GPT-5 계열 기본값. 다른 모델에서 미지원 오류가 나면 빈 값으로 변경
OPENAI_REASONING_EFFORT=low
# 관리자 화면에 입력할 코드. 외부 공개 전 반드시 변경
ADMIN_TOKEN=local-admin-2026
# LangSmith를 사용할 때 true로 변경하고 키 입력
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=response-rehearsal
# 계정이 US 이외 리전이면 LangSmith 설정에 표시되는 API URL 입력
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Policy RAG shares OPENAI_API_KEY; index is cached under backend/data/chroma.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
